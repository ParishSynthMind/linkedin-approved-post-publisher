# Claude (drafting). Leave unset and use `draft --offline` to try it with no key.
ANTHROPIC_API_KEY=

# Where the LinkedIn app keys and token live: keychain (macOS, default) or file.
LINKEDIN_TOKEN_STORE=file
LINKEDIN_TOKEN_FILE=.linkedin_token.json
# With the file store, the app keys come from here (Developer Portal > your app > Auth tab).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must match an "Authorized redirect URL" on the app's Auth tab exactly.
LINKEDIN_REDIRECT_URI=http://localhost:8765/callback

# Linkedin-Version header (YYYYMM). LinkedIn supports each version for at least a year.
LINKEDIN_VERSION=202610
# posts = /rest/posts (default). ugcposts = legacy /v2/ugcPosts, as shown on the Share on LinkedIn page.
LINKEDIN_API=posts

QUEUE_DIR=queue
